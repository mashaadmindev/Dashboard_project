# Copy this file to .env and adjust credentials to match your local PostgreSQL setup
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ford_database

# Ford Maximo asset API (live "Maximo_Budget" count on Team Wise) — optional;
# if unset, Team Wise falls back to an uploaded maximo_budget table.
TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
SCOPE=
API_URL=
